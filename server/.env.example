# EventForge Production Server Configuration Template
# Copy this file to .env and configure with production credentials.

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (Render injects PORT automatically; use 5001 locally)
PORT=5001

# MongoDB Atlas connection string. Atlas clusters are replica sets, which is
# required for EventForge's transactional ticket and waitlist operations.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/eventforge?retryWrites=true&w=majority

# Core Authentication JWT Secret (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_minimum_32_character_jwt_secret_phrase_for_production

# Core JWT Token Expiration Window
JWT_EXPIRES_IN=7d

# Cryptographic Badge Signing Key (HMAC-SHA256, minimum 32 characters)
BADGE_JWT_SECRET=replace_with_a_secure_minimum_32_character_badge_signing_key_for_production

# Live Stripe Payment Gateway Integration
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_stripe_webhook_signing_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_publishable_key

# Live OpenAI Generative AI Engine Integration
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your_production_openai_api_key

# Frontend client origin(s), comma-separated. Add the Vercel production URL;
# optionally add localhost and preview URLs while testing.
CLIENT_URL=https://your-project.vercel.app,http://localhost:5173
